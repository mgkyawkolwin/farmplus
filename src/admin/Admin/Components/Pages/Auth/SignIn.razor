@page "/auth/signin"
@layout MainLayout

@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.Extensions.Configuration
@using System.Net.Http.Json
@using System.Text.Json
@using FarmPlus.Api.Dtos.Auth
@using Microsoft.FluentUI.AspNetCore.Components

@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject ILogger<SignIn> Logger
@inject IHttpContextAccessor HttpContextAccessor


<PageTitle>Admin Sign In</PageTitle>

<div class="d-flex justify-content-center align-items-center w-100">
    <FluentCard Style="max-width: 420px; width: 100%; padding: 2rem;">
        <div class="text-center mb-4">
            <h2 class="mt-3 mb-1">Admin Portal</h2>
            <p class="text-muted">Sign in to continue</p>
        </div>

        @* 2. Standard HTTP POST form submission *@
        <EditForm FormName="signInForm" Model="Input" method="post" OnValidSubmit="HandleSignInAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <label class="form-label">Username</label>
            <FluentTextField Name="Input.Username"
                             @bind="Input.Username"
                             Placeholder="Username or email"
                             Style="width: 100%; margin-bottom: 1rem;" />

            <label class="form-label">Password</label>
            <FluentTextField Name="Input.Password"
                             @bind="Input.Password"
                             TextFieldType="TextFieldType.Password"
                             Placeholder="Password"
                             Style="width: 100%; margin-bottom: 1rem;" />

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="alert alert-danger" role="alert">@_errorMessage</div>
            }

            <button type="submit" class="btn btn-primary w-100">Sign in</button>
        </EditForm>
    </FluentCard>
</div>

@code {
    // 3. Receives HTTP POST form data automatically
    [SupplyParameterFromForm]
    private SignInModel Input { get; set; } = new();

    // 4. Receives HttpContext directly from ASP.NET Core pipeline
    @* [CascadingParameter]
    private HttpContext? HttpContext { get; set; } *@

    private string? _errorMessage;

    private async Task HandleSignInAsync()
    {
        _errorMessage = null;

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is null)
        {
            _errorMessage = "Unable to process authentication request.";
            return;
        }

        try
        {
            var apiBaseUrl = Configuration["ApiBaseUrl"] ?? string.Empty;
            Console.WriteLine($"API Base URL: {apiBaseUrl}"); // Debugging line
            if (string.IsNullOrWhiteSpace(apiBaseUrl))
            {
                _errorMessage = "API base URL is not configured.";
                return;
            }

            var client = HttpClientFactory.CreateClient();
            var requestUrl = new Uri(new Uri(apiBaseUrl), "auth/signinadmin");
            Console.WriteLine($"Request URL: {requestUrl}"); // Debugging line
            var request = new HttpRequestMessage(HttpMethod.Post, requestUrl)
            {
                Content = JsonContent.Create(new LoginDto(Input.Username, Input.Password))
            };

            using var response = await client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
            // Log all Set-Cookie headers
            if (response.Headers.TryGetValues("Set-Cookie", out var cookieValues))
            {
                foreach (var cookie in cookieValues)
                {
                    Console.WriteLine($"Set-Cookie: {cookie}");
                    // Or use your preferred logging method
                    // _logger.LogInformation("Set-Cookie: {Cookie}", cookie);
                }
            }
            var responseContent = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                Logger.LogWarning("Admin sign in API returned {Status}. Response: {Response}", response.StatusCode, responseContent);
                _errorMessage = "Invalid username or password.";
                return;
            }

            // Forward Set-Cookie headers from the API response to the browser
            if (response.Headers.TryGetValues("Set-Cookie", out var setCookieValues))
            {
                foreach (var headerValue in setCookieValues)
                {
                    httpContext.Response.Headers.Append("Set-Cookie", headerValue);
                }
            }

            var apiResult = JsonSerializer.Deserialize<ApiResult<AdminAuthResponseDto>>(responseContent, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });

            if (apiResult?.Success != true || apiResult.Data?.User is null)
            {
                _errorMessage = apiResult?.Message ?? "Invalid username or password.";
                return;
            }

            Navigation.NavigateTo("/counter", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Admin sign in failed.");
            _errorMessage = ex.Message;
        }
    }

    private sealed record ApiResult<T>(bool Success, T? Data, string? Message);

    public sealed class SignInModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}