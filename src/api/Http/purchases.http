@API_URL=http://127.0.0.1:5555/api
@TOKEN=replace-with-access-token
@PURCHASE_ID=00000000-0000-0000-0000-000000000000
@SUPPLIER_ID=00000000-0000-0000-0000-000000000000
@PRODUCT_ID=00000000-0000-0000-0000-000000000000

### List purchases
GET {{API_URL}}/purchases?page=1&pageSize=20
Authorization: Bearer {{TOKEN}}

### Get a purchase
GET {{API_URL}}/purchases/{{PURCHASE_ID}}
Authorization: Bearer {{TOKEN}}

### Create a purchase
POST {{API_URL}}/purchases
Content-Type: application/json
Authorization: Bearer {{TOKEN}}

{
  "supplierId": "{{SUPPLIER_ID}}",
  "purchaseDate": "2026-10-03T00:00:00Z",
  "discount": 0,
  "tax": 0,
  "items": [
    {
      "productId": "{{PRODUCT_ID}}",
      "quantity": 5,
      "unitPrice": 1250
    }
  ]
}

### Update a purchase
PUT {{API_URL}}/purchases/{{PURCHASE_ID}}
Content-Type: application/json
Authorization: Bearer {{TOKEN}}

{
  "supplierId": "{{SUPPLIER_ID}}",
  "purchaseDate": "2026-10-03T00:00:00Z",
  "discount": 0,
  "tax": 0,
  "rowVersion": "replace-with-row-version",
  "items": [
    {
      "productId": "{{PRODUCT_ID}}",
      "quantity": 5,
      "unitPrice": 1250
    }
  ]
}

### Delete a purchase
DELETE {{API_URL}}/purchases/{{PURCHASE_ID}}
Authorization: Bearer {{TOKEN}}